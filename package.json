{
	"name": "@signageos/codestyle",
	"version": "2.1.0",
	"main": "eslint.config.mjs",
	"author": "signageOS.io <dev@signageos.io>",
	"license": "MIT",
	"engines": {
		"node": ">=18",
		"npm": ">=9"
	},
	"bin": {
		"sos-prettier": "./bin/sos-prettier.sh"
	},
	"scripts": {
		"clean-build": "cat eslint.config.public.mjs > eslint.config.mjs",
		"test": "mocha \"tests/**/*.test.mjs\"",
		"lint": "DISABLE_FIXTURES=1 eslint",
		"check": "echo No checks needed",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "9.39.4",
		"@typescript-eslint/eslint-plugin": "8.57.2",
		"@typescript-eslint/parser": "8.57.2",
		"eslint": "9.39.4",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-mocha": "11.2.0",
		"eslint-plugin-prettier": "5.5.5",
		"eslint-plugin-unused-imports": "4.4.1",
		"prettier": "3.8.3",
		"prettier-plugin-sh": "0.18.1",
		"semver": "7.7.4",
		"typescript-eslint": "8.57.2"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "25.5.0",
		"@types/semver": "7.7.1",
		"mocha": "11.7.6"
	}
}
